# Secrets and local configuration
.env
.env.local
.env.*.local

# Generated autoinstall (may embed secrets from .env)
autoinstall.yaml
.autoinstall.yaml.*

# Samovar private config and signatures (contain Wi-Fi passwords, NetBird keys, proxy credentials)
samovar-config.json
samovar-config.json.sig
*.sig
*.sha256

# Offline bundle artifacts (large binaries, reproducible from lock files)
offline/*.deb
offline/*.tar.gz
offline/packages/
offline/cache/
offline/images/

# Ubuntu / autoinstall ISO images (multi-GB binaries)
*.iso

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
ENV/

# Editor / OS junk
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Build scratch under the project tree
/tmp/
/iso-build/
/work/

# Test fixtures are committed and must not be ignored
!tests/fixtures/**
