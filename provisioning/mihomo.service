[Unit]
Description=Mihomo Proxy Service (Docker Compose)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
ConditionPathExists=/etc/mihomo/config.yaml
ConditionPathExists=/etc/mihomo/compose.yml
Documentation=https://github.com/MetaCubeX/mihomo

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/etc/mihomo
ExecStart=/usr/bin/docker compose --env-file /etc/mihomo/compose.env -f /etc/mihomo/compose.yml up -d --remove-orphans mihomo
ExecStop=/usr/bin/docker compose --env-file /etc/mihomo/compose.env -f /etc/mihomo/compose.yml down
ExecReload=/usr/bin/docker compose --env-file /etc/mihomo/compose.env -f /etc/mihomo/compose.yml restart mihomo
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
