#!/bin/sh
# proxy-shell
#
# Opens a shell with Mihomo proxy environment variables set.
# Does NOT change global routes or system-wide proxy settings.
# The proxy is scoped strictly to the spawned shell session.
#
# Usage:
#   proxy-shell           # Opens $SHELL with proxy env set
#   sudo -u alex proxy-shell

export HTTP_PROXY="http://127.0.0.1:7890"
export HTTPS_PROXY="http://127.0.0.1:7890"
export ALL_PROXY="socks5://127.0.0.1:7890"
export http_proxy="$HTTP_PROXY"
export https_proxy="$HTTPS_PROXY"
export all_proxy="$ALL_PROXY"

echo "Proxy environment set: $HTTP_PROXY"
exec "${SHELL:-/bin/bash}"
