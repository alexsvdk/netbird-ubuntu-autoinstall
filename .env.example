# Copy to .env and fill in values:
#   cp .env.example .env
#
# Any variable set here (or exported in the shell) skips the interactive prompt.
# Leave a value empty to be prompted at build time.

# Ubuntu live-server release to download / repack
UBUNTU_VERSION=24.04.4

# Target CPU architecture (ISO + apt package arches):
#   amd64  — x86_64 (default; releases.ubuntu.com)
#   arm64  — aarch64 (cdimage.ubuntu.com + ports.ubuntu.com)
# Aliases: x86_64/x64 → amd64, aarch64/arm → arm64
ARCH=amd64

# Where to download the official live-server ISO from (only if not already present):
#   auto     — parallel speed-test of popular CD mirrors, pick the fastest (default)
#   default  — official Canonical only (releases.ubuntu.com / cdimage.ubuntu.com)
#   https://mirror.yandex.ru/ubuntu-releases  — fixed base mirror
#   https://…/ubuntu-….iso                     — full ISO URL
# ISO_URL=… overrides ISO_MIRROR entirely.
ISO_MIRROR=auto
# ISO_URL=

# Output ISO filename (relative to this directory).
# Default if unset: ubuntu-${UBUNTU_VERSION}-autoinstall-${ARCH}.iso
# OUTPUT_ISO=ubuntu-24.04.4-autoinstall-amd64.iso

# Machine identity written into autoinstall.yaml
# HOSTNAME is taken from this file (shell HOSTNAME is ignored to avoid using the
# builder machine name). You can also set TARGET_HOSTNAME instead.
HOSTNAME=friend-server
# TARGET_HOSTNAME=friend-server
USERNAME=server

# Console login password (sudo is passwordless). Prefer setting this only in .env,
# not in shell history. Leave empty to type it interactively.
PASSWORD=

# SSH public key for authorized_keys (e.g. contents of ~/.ssh/id_ed25519.pub)
SSH_PUBLIC_KEY=

# NetBird one-off setup key — revoke after the server enrolls. The generated ISO
# contains this secret until it is rebuilt, so do not share or reuse the ISO.
NETBIRD_SETUP_KEY=

# --- APT / Ubuntu mirrors (speeds up package download during install & on the target) ---
#
# APT_REGION selects how primary mirrors are chosen:
#   auto     — geoip country-mirror, then archive.ubuntu.com (default, good everywhere)
#   default  — only http://archive.ubuntu.com/ubuntu (no geoip)
#   ru, de, nl, jp, us, ... — official country mirror http://XX.archive.ubuntu.com/ubuntu
#   custom   — use APT_MIRROR only (still falls back to archive.ubuntu.com)
#
# APT_MIRROR is an optional preferred URI prepended to the candidate list, e.g.:
#   http://mirror.yandex.ru/ubuntu
#   http://ftp.halifax.rwth-aachen.de/ubuntu
#   http://mirror.hetzner.com/ubuntu/packages
#
# APT_SECURITY_MIRROR overrides the security pocket (default: Ubuntu security).
# APT_FALLBACK: offline-install | abort | continue-anyway
APT_REGION=auto
# APT_MIRROR=
# APT_SECURITY_MIRROR=
# APT_FALLBACK=offline-install

# --- Samovar Autoinstall settings (spec: samovar-autoinstall-spec.md) ---
# Set SAMOVAR_MODE=samovar to build the dedicated image for target "samovar".
# When samovar-config.json exists in this directory, samovar mode is auto-detected.
# SAMOVAR_MODE=samovar
# SAMOVAR_CONFIG_FILE=samovar-config.json
# Optional disk serial prefix used by the guest OS in VM builds.
# Leave empty for physical hardware. For QEMU IDE disks use:
# DISK_SERIAL_PREFIX=QEMU_HARDDISK_
# Swap size in GiB for each of /swapfile and /data/swapfile (default: 1).
# SWAP_SIZE_GIB=8
# Network interface profile for Samovar:
#   both  — physical target: lan0 + wifi0 (default)
#   lan0  — Ethernet only (useful for a test VM)
#   wifi0 — Wi-Fi only
NETWORK_INTERFACE=both
# ntfy.sh topic for installation status notifications (use a unique topic).
NOTIFY_TOPIC=samovar_test
#
# Path to the SSH private key used to sign samovar-config.json with namespace 'samovar-recovery'
# SIGNING_KEY=~/.ssh/id_ed25519
#
# Allowed signers line(s) for SSH signature verification on the target.
# Format: <principal> namespaces="samovar-recovery" <key-type> <public-key>
# ALLOWED_SIGNERS=
#
# Multiple SSH public keys (newline-separated or comma-separated):
# SSH_PUBLIC_KEYS=
#
# Grant passwordless sudo to USERNAME (default true):
# SUDO_NOPASSWD=true
